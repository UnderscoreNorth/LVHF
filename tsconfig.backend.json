{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src/lib/express.ts", "src/lib/db/**/*"],
	"exclude": ["node_modules"]
}
