# Backend Dockerfile for Express + SQLite
FROM node:22-slim

RUN apt-get update && apt-get install -y python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./

# Install dependencies (including dev dependencies for ts-node)
RUN npm ci

# Copy source code
COPY src ./src

# Create volume mount point for SQLite database
RUN mkdir -p /app/data

# Expose backend port
EXPOSE 5175

# Set environment to production
ENV NODE_ENV=production

# Start the Express server using ts-node
CMD ["npx", "tsx", "src/lib/express.ts"]
